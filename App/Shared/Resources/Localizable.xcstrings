    "You can hatch, care for and collect Mixlings. Breeding with friends, trading and sharing stay off for now.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти можеш виводити, доглядати й колекціонувати Міксликів. Схрещування з друзями, обмін і поширення поки вимкнені."
          }
        }
      }
    },
    "You got %lld sparks!": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You got %lld spark!"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
