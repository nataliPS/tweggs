    "Before any mutation is unlocked the chance is 0%. Each gene a baby gets is one of the two genes from each parent, picked at random.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доки жодну мутацію не відкрито, шанс 0%. Кожен ген маля — один із двох генів кожного з батьків, вибраний випадково."
          }
        }
      }
    },
    "Belly": {
