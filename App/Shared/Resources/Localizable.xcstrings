{
  "sourceLanguage": "en",
  "strings": {
    "%@ can breed once it's a teen, in 2 days.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ зможе схрещуватися, коли стане підлітком — за 2 дні."
          }
        }
      }
    },
    "%@ is feeling sleepy. A little care will cheer them up!": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ трохи сонний. Трохи турботи — і настрій покращиться!"
          }
        }
      }
    },
    "%@ isn't a fan of this weather. A little help?": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не дуже любить таку погоду. Допоможеш?"
          }
        }
      }
    },
    "%@ just hatched! Breed with me on Tweggs.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ щойно вилупився! Схрестимо в Tweggs."
          }
        }
      }
    },
    "%@ loves this weather!": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ обожнює таку погоду!"
          }
        }
      }
    },
